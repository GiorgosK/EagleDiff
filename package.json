{
  "name": "eaglediff",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "eaglediff": "bin/eaglediff.js"
  },
  "type": "commonjs",
  "scripts": {
    "cli": "node bin/eaglediff.js",
    "config": "node scripts/config.js",
    "config-update": "node scripts/config-update.js",
    "import": "node scripts/import.js",
    "reference": "node scripts/run.js reference",
    "test": "node scripts/run.js test",
    "approve": "node scripts/run.js approve",
    "results": "node scripts/results.js",
    "clean": "node scripts/clean.js",
    "report": "node scripts/report.js",
    "test:unit": "node --test --test-concurrency=4 tests/*.test.js",
    "test:coverage": "node --test --test-concurrency=4 --experimental-test-coverage tests/*.test.js"
  },
  "dependencies": {
    "puppeteer-core": "^25.12.0",
    "reg-publish-filesystem-plugin": "^0.2.0",
    "reg-simple-keygen-plugin": "^0.14.2",
    "reg-suit": "^0.14.5",
    "transliteration": "^2.6.1"
  },
  "description": "Capture browser views and compare visual changes."
}
