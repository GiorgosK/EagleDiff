{
  "version": "2026.11.22.01",
  "referenceBaseURL": "https://eaglediff-umami.ddev.site",
  "testBaseURL": "https://eaglediff-umami.ddev.site",
  "excludeExtensions": [
    ".pdf",
    ".doc",
    ".docx",
    ".xls",
    ".xlsx",
    ".ppt",
    ".pptx",
    ".zip",
    ".rar",
    ".7z",
    ".tar",
    ".gz"
  ],
  "core": {
    "workers": 10,
    "thresholdRate": 0.001,
    "thresholdRateColor": 0.05,
    "thresholdMaxPixels": 500,
    "temporaryErrorRetries": 2,
    "temporaryErrorRetryMode": "immediate",
    "temporaryErrorRetryTimeoutMultiplier": 1,
    "protocolTimeout": 60000
  },
  "defaults": {
    "delay": 500,
    "fullPage": true,
    "videoCaptureMode": "placeholder",
    "freezeWebAnimations": true,
    "stabilizeSVGAnimations": true,
    "svgAnimationTimeout": 15000,
    "captureBeyondViewport": "auto",
    "waitForIframes": true,
    "iframeTimeout": 30000,
    "waitUntil": "domcontentloaded",
    "navigationTimeout": 30000,
    "cookieConsent": "hide",
    "cookieConsentTimeout": 3000,
    "cookiePath": null,
    "cookies": [],
    "cookieDomain": null,
    "cookieExpiry": null,
    "readyTimeout": 10000,
    "fontTimeout": 30000,
    "requiredFonts": [],
    "readySelector": "",
    "waitForJQueryReady": true,
    "jqueryReadyTimeout": 30000,
    "waitForDrupalReady": true,
    "drupalReadyTimeout": 30000,
    "readyVisible": false,
    "browserVerification": {
      "challengeSelectors": [
        "script[src*=\"/botbuster/js/challenge.js\"]"
      ],
      "errorSelectors": [
        "#error"
      ],
      "timeout": 30000,
      "settleDelayMs": 500
    },
    "waitForStableContent": {
      "triggerSelectors": [
        "script#CookieDeclaration"
      ],
      "selectors": [
        ".CookieDeclaration",
        "#CookieDeclaration"
      ],
      "timeout": 15000,
      "settleDelayMs": 750
    },
    "waitUntilGone": [],
    "waitUntilGoneTimeout": 10000,
    "scrollTimeout": 30000,
    "carouselSelectors": null,
    "carouselSettleDelayMs": 500,
    "keepSelectors": [],
    "lazyImageTimeout": 15000,
    "retryImageDownloads": false,
    "imageDownloadTimeout": 15000,
    "imageFailurePolicy": "error",
    "normalizeResponsiveImageSelectors": [
      "img",
      "picture source"
    ],
    "normalizeImageDecodingSelectors": [
      "img"
    ],
    "randomImage": [],
    "randomContent": [],
    "replaceContent": {},
    "cssOverrides": "",
    "hideDynamicSelectors": [
      "#toolbar-administration",
      "#toolbar-item-administration-tray",
      ".toolbar-tray-open"
    ],
    "networkIdleTime": 500,
    "networkIdleTimeout": 5000,
    "http404Policy": "warn",
    "failOnResponseStatusCodes": [
      500,
      502,
      503,
      504
    ],
    "hideSelectors": [
      "[id^=\"div-gpt-ad\"]",
      "iframe[src^=\"https://www.google.com/maps/embed\"]",
      "iframe[src^=\"https://www.google.com/maps/d/embed\"]"
    ],
    "removeSelectors": [
      ".CookieDeclaration",
      "#CookieDeclaration"
    ]
  },
  "onBeforeScript": [
    "hooks/wait-for-drupal-ready",
    "hooks/handle-cookie-consent",
    "hooks/hide-dynamic-elements",
    "hooks/disable-animations",
    "hooks/apply-css-overrides"
  ],
  "onReadyScript": [
    "hooks/wait-for-browser-verification",
    "hooks/fail-on-response-status",
    "hooks/handle-cookie-consent",
    "hooks/wait-for-element",
    "hooks/wait-until-gone",
    "hooks/scroll-to-bottom",
    "hooks/hide-dynamic-elements",
    "hooks/disable-animations",
    "hooks/wait-for-fonts",
    "hooks/pause-media",
    "hooks/load-lazy-images",
    "hooks/wait-for-jquery-ready",
    "hooks/wait-for-drupal-ready",
    "hooks/normalize-responsive-images",
    "hooks/replace-random-content",
    "hooks/apply-css-overrides",
    "hooks/normalize-image-decoding",
    "hooks/wait-for-stable-content",
    "hooks/keep-selectors",
    "hooks/wait-for-background-images",
    "hooks/wait-for-network-idle",
    "hooks/stabilize-carousels",
    "hooks/freeze-web-animations",
    "hooks/stabilize-svg-animations",
    "hooks/prepare-iframes"
  ],
  "viewports": [
    {
      "label": "phone",
      "width": 360,
      "height": 640
    },
    {
      "label": "tablet",
      "width": 1024,
      "height": 768
    },
    {
      "label": "pc",
      "width": 1920,
      "height": 1080
    }
  ],
