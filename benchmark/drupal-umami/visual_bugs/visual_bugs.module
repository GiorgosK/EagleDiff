<?php

/**
 * @file
 * Known visual bugs for the Umami demo; see ../bugs.json for the list.
 *
 * Each bug is scoped to one page by a data-visual-bug attribute on <html>, so
 * pages without a bug render exactly as on the clean site.
 */

/**
 * Returns the bug id of the current page, keyed by language and system path.
 */
function _visual_bugs_current(): ?string {
  $bugs = [
    'en:/node/1' => 'b01',
    'en:/node/2' => 'b02',
    'en:/node/3' => 'b03',
    'en:/node/4' => 'b04',
    'en:/node/5' => 'b05',
    'en:/node/6' => 'b06',
    'en:/node/7' => 'b07',
    'en:/node/8' => 'b08',
    'en:/node/9' => 'b09',
    'en:/node/10' => 'b10',
    'en:/node/11' => 'b11',
    'en:/node/12' => 'b12',
    'en:/node/13' => 'b13',
    'en:/node/15' => 'b14',
    'en:/node/19' => 'b15',
    'en:/articles' => 'b16',
    'en:/recipes' => 'b17',
    'en:<front>' => 'b18',
    'es:<front>' => 'b19',
    'es:/node/1' => 'b20',
    'es:/articles' => 'b21',
    'es:/node/2' => 'b22',
    'es:/node/11' => 'b23',
    'es:/node/12' => 'b24',
    'es:/node/13' => 'b25',
    'es:/node/14' => 'b26',
    'es:/node/15' => 'b27',
  ];
  $language = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $path = \Drupal::service('path.matcher')->isFrontPage() ? '<front>' : \Drupal::service('path.current')->getPath();
  return $bugs["$language:$path"] ?? NULL;
}

/**
 * Implements hook_page_attachments().
 */
function visual_bugs_page_attachments(array &$attachments) {
  $attachments['#attached']['library'][] = 'visual_bugs/bugs';
}

/**
 * Implements hook_preprocess_html().
 */
function visual_bugs_preprocess_html(array &$variables) {
  if ($bug = _visual_bugs_current()) {
    $variables['html_attributes']->setAttribute('data-visual-bug', $bug);
  }
}

/**
 * Implements hook_preprocess_node().
 *
 * b13: a one-letter typo in an article title (a content change, not CSS).
 * Umami prints the page title from the full node view.
 */
function visual_bugs_preprocess_node(array &$variables) {
  if ($variables['view_mode'] === 'full' && $variables['node']->id() == 13
    && $variables['node']->language()->getId() === 'en') {
    $variables['label'] = 'The real deal for supermaket savvy shopping';
  }
}

